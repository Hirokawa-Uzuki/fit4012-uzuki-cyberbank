<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Uzuki CyberBank</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Rajdhani:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
            :root {
                --neon-blue: #00f3ff;
                --neon-purple: #bc13fe;
                --neon-red: #ff003c;
                --dark-bg: #0b0c10;
                --glass-bg: rgba(11, 12, 16, 0.7);
                --glass-border: rgba(0, 243, 255, 0.2);
            }

            body {
                background-color: var(--dark-bg);
                color: #c5c6c7;
                font-family: 'Rajdhani', sans-serif;
                background-image: linear-gradient(rgba(0, 243, 255, 0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 243, 255, 0.03) 1px, transparent 1px);
                background-size: 30px 30px;
                overflow-x: hidden;
            }

            h1, h2, h3, h4, h5, h6, .navbar-brand {
                font-family: 'Orbitron', sans-serif;
                letter-spacing: 1px;
            }

            /* Preloader - Màn hình chờ */
            #preloader {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: var(--dark-bg);
                z-index: 9999;
                display: flex;
                justify-content: center;
                align-items: center;
                flex-direction: column;
                transition: opacity 0.5s ease;
            }

            .cyber-loader {
                width: 50px;
                height: 50px;
                border: 3px solid transparent;
                border-top-color: var(--neon-blue);
                border-bottom-color: var(--neon-purple);
                border-radius: 50%;
                animation: spin 1s linear infinite;
            }

            .loader-text {
                margin-top: 15px;
                color: var(--neon-blue);
                font-family: 'Orbitron', sans-serif;
                animation: pulse 1.5s infinite;
            }

            /* Navbar - Glassmorphism */
            .glass-navbar {
                background: var(--glass-bg);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid var(--glass-border);
                box-shadow: 0 4px 30px rgba(0, 0, 0, 0.5);
                transition: all 0.3s ease;
            }

            .navbar-brand {
                color: var(--neon-blue) !important;
                text-shadow: 0 0 10px var(--neon-blue);
                font-weight: 700;
            }

            .nav-link {
                color: #fff !important;
                font-weight: 500;
                position: relative;
                transition: 0.3s;
            }

                .nav-link:hover {
                    color: var(--neon-blue) !important;
                    text-shadow: 0 0 8px var(--neon-blue);
                }

                .nav-link::after {
                    content: '';
                    position: absolute;
                    width: 0;
                    height: 2px;
                    bottom: 0;
                    left: 0;
                    background-color: var(--neon-blue);
                    transition: all 0.3s;
                }

                .nav-link:hover::after {
                    width: 100%;
                }

            /* Nút bấm Cyberpunk */
            .cyber-btn {
                background: transparent;
                color: var(--neon-blue);
                border: 1px solid var(--neon-blue);
                border-radius: 0;
                padding: 8px 20px;
                position: relative;
                text-transform: uppercase;
                font-weight: bold;
                font-family: 'Orbitron', sans-serif;
                transition: 0.3s;
                overflow: hidden;
                text-decoration: none;
                display: inline-block;
            }

                .cyber-btn:hover {
                    background: var(--neon-blue);
                    color: #000;
                    box-shadow: 0 0 15px var(--neon-blue);
                }

            .cyber-btn-danger {
                color: var(--neon-red);
                border-color: var(--neon-red);
            }

                .cyber-btn-danger:hover {
                    background: var(--neon-red);
                    color: #fff;
                    box-shadow: 0 0 15px var(--neon-red);
                }

            /* Ghi đè thẻ Card mặc định của Bootstrap */
            .card {
                background: rgba(15, 15, 26, 0.8) !important;
                border: 1px solid rgba(255, 255, 255, 0.1);
                backdrop-filter: blur(5px);
                border-radius: 8px;
                transition: transform 0.3s, box-shadow 0.3s;
            }

                .card:hover {
                    transform: translateY(-5px);
                    box-shadow: 0 10px 20px rgba(0, 243, 255, 0.15);
                    border-color: var(--neon-blue);
                }

            /* Tùy chỉnh thanh cuộn (Scrollbar) */
            ::-webkit-scrollbar {
                width: 8px;
            }

            ::-webkit-scrollbar-track {
                background: var(--dark-bg);
            }

            ::-webkit-scrollbar-thumb {
                background: var(--neon-purple);
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: var(--neon-blue);
                }

            /* Animation Keyframes */
            @@keyframes spin {
                100% {
                    transform: rotate(360deg);
                }
            }
            @@keyframes pulse {
                0% {
                    opacity: 0.5;
                }

                50% {
                    opacity: 1;
                    text-shadow: 0 0 10px var(--neon-blue);
                }

                100% {
                    opacity: 0.5;
                }
            }

            /* Footer */
            .cyber-footer {
                border-top: 1px solid var(--glass-border);
                background: var(--glass-bg);
                padding: 15px 0;
                margin-top: 50px;
                font-size: 0.9rem;
            }

            .hacker-text {
                color: #4af626;
                font-family: monospace;
            }
    </style>
</head>
<body>
    <div id="preloader">
        <div class="cyber-loader"></div>
        <div class="loader-text">INITIALIZING SECURE CONNECTION...</div>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg glass-navbar fixed-top">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fa-solid fa-shield-halved me-2"></i>UZUKI_CYBERBANK
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarCyber" aria-controls="navbarCyber" aria-expanded="false" aria-label="Toggle navigation">
                    <i class="fa-solid fa-bars text-info"></i>
                </button>

                <div class="collapse navbar-collapse" id="navbarCyber">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fa-solid fa-desktop me-1"></i> Dashboard
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3" asp-area="" asp-controller="Home" asp-action="Leaderboard">
                                <i class="fa-solid fa-trophy me-1"></i> Leaderboard
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle px-3" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fa-solid fa-network-wired me-1"></i> Logs Hệ thống
                            </a>
                            <ul class="dropdown-menu dropdown-menu-dark glass-navbar border-info">
                                <li><a class="dropdown-item" asp-controller="System" asp-action="AuditLogs"><i class="fa-solid fa-list-check me-2"></i>Audit Logs</a></li>
                                <li><a class="dropdown-item" asp-controller="System" asp-action="ThreatModel"><i class="fa-solid fa-bug me-2"></i>Threat Model</a></li>
                                <li><hr class="dropdown-divider border-info"></li>
                                <li><a class="dropdown-item" asp-controller="System" asp-action="ServerStatus"><i class="fa-solid fa-server me-2"></i>Server Status</a></li>
                            </ul>
                        </li>
                    </ul>

                    <div class="d-flex align-items-center">
                        @if (User.Identity.IsAuthenticated)
                        {
                            <div class="text-end me-3">
                                <span class="d-block text-white" style="font-size: 0.85rem;">Authorized User</span>
                                <strong class="text-info" style="font-family: 'Orbitron', sans-serif; letter-spacing: 1px;">
                                    <i class="fa-solid fa-user-ninja me-1"></i>@User.Identity.Name
                                </strong>
                            </div>
                            <button id="muteToggle" class="cyber-btn me-2 px-3" style="border-color: #00f3ff; color: #00f3ff;">
                                <i class="fa-solid fa-volume-high"></i>
                            </button>
                            <a class="cyber-btn cyber-btn-danger" asp-controller="Auth" asp-action="Logout">
                                <i class="fa-solid fa-power-off me-1"></i> DISCONNECT
                            </a>
                        }
                        else
                        {
                            <a class="cyber-btn me-2" asp-controller="Auth" asp-action="Login">LOGIN</a>
                            <a class="cyber-btn" style="border-color: var(--neon-purple); color: var(--neon-purple);" asp-controller="Auth" asp-action="Register">REGISTER</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container" style="margin-top: 100px; min-height: 80vh;">
        <main role="main" class="pb-3 position-relative">
            @RenderBody()
        </main>
    </div>

    <footer class="cyber-footer text-center">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-4 text-md-start mb-2 mb-md-0">
                    <span class="text-muted"><i class="fa-solid fa-terminal me-2"></i>Client: ANV15-51 [RTX 3050]</span>
                </div>
                <div class="col-md-4 mb-2 mb-md-0">
                    <strong style="color: var(--neon-blue); font-family: 'Orbitron', sans-serif;">&copy; 2026 - UZUKI CYBERBANK</strong>
                </div>
                <div class="col-md-4 text-md-end">
                    <span class="hacker-text">[ Nhóm 15 ]</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(window).on('load', function() {
        // Hiệu ứng tắt màn hình chờ mượt mà
        setTimeout(function() {
        $('#preloader').css('opacity', '0');
        setTimeout(function() {
        $('#preloader').remove();
        }, 500);
        }, 800); // Đợi 0.8s để load xong CSS

        // Console log ẩn kiểu Hacker
        console.log("%c[SYSTEM INFO] Bypassing firewall...", "color: #00f3ff; font-size: 14px; font-weight: bold;");
        console.log("%c[SUCCESS] Connected to Secure Node.", "color: #4af626; font-size: 14px;");
        });

        // Hiệu ứng bóng mờ cho Navbar khi cuộn trang
        $(window).scroll(function() {
        if ($(window).scrollTop() > 50) {
        $('.glass-navbar').css('background', 'rgba(11, 12, 16, 0.95)');
        $('.glass-navbar').css('box-shadow', '0 4px 30px rgba(0, 243, 255, 0.2)');
        } else {
        $('.glass-navbar').css('background', 'rgba(11, 12, 16, 0.7)');
        $('.glass-navbar').css('box-shadow', '0 4px 30px rgba(0, 0, 0, 0.5)');
        }
        });
    </script>
    <audio id="bgmAudio" loop>
        <source src="~/audio/bgm-cyber.mp3" type="audio/mpeg">
    </audio>
    <audio id="clickAudio">
        <source src="~/audio/click.mp3" type="audio/mpeg">
    </audio>
    <audio id="successAudio">
        <source src="~/audio/success.mp3" type="audio/mpeg">
    </audio>
    <audio id="alarmAudio">
        <source src="~/audio/alarm.mp3" type="audio/mpeg">
    </audio>

    <script>
        $(document).ready(function () {
        const bgm = document.getElementById('bgmAudio');
        const clickSfx = document.getElementById('clickAudio');
        const muteBtn = document.getElementById('muteToggle');

        // Chỉnh âm lượng mặc định (Nhạc nền nên để nhỏ để không điếc tai)
        bgm.volume = 0.2;
        clickSfx.volume = 0.5;

        // Kiểm tra xem lần trước người chơi có tắt tiếng không (lưu trong LocalStorage)
        let isMuted = localStorage.getItem('uzuki_muted') === 'true';

        function updateAudioState() {
        bgm.muted = isMuted;
        clickSfx.muted = isMuted;
        // Thêm logic mute cho các âm thanh khác
        document.getElementById('successAudio').muted = isMuted;
        document.getElementById('alarmAudio').muted = isMuted;

        if (isMuted) {
        muteBtn.innerHTML = '<i class="fa-solid fa-volume-xmark text-danger"></i>';
        muteBtn.style.borderColor = '#ff003c';
        } else {
        muteBtn.innerHTML = '<i class="fa-solid fa-volume-high"></i>';
        muteBtn.style.borderColor = '#00f3ff';
        }
        }

        // Gọi hàm cập nhật icon loa ngay khi load trang
        updateAudioState();

        // Xử lý nút click Bật/Tắt loa
        muteBtn.addEventListener('click', function () {
        isMuted = !isMuted;
        localStorage.setItem('uzuki_muted', isMuted);
        updateAudioState();

        // Nếu bật loa lên mà nhạc chưa chạy thì ép chạy
        if (!isMuted && bgm.paused) {
        bgm.play().catch(e => console.log("Cần tương tác để phát nhạc."));
        }
        });

        // TRICK QUA MẶT TRÌNH DUYỆT: Phát nhạc nền ngay khi người chơi click chuột lần đầu tiên vào bất cứ đâu
        $('body').on('click.initAudio', function () {
        if (!isMuted && bgm.paused) {
        bgm.play();
        }
        // Hủy event này sau khi nhạc đã chạy thành công
        $('body').off('click.initAudio');
        });

        // Hiệu ứng SFX khi di chuột và click vào các nút cyber-btn
        $('.cyber-btn').on('mouseenter', function () {
        if (!isMuted) {
        // Có thể thêm tiếng di chuột (hover.mp3) nếu muốn
        }
        });

        $('.cyber-btn, .nav-link').on('click', function () {
        if (!isMuted) {
        clickSfx.currentTime = 0; // Tua lại đầu để phát liên tục được
        clickSfx.play();
        }
        });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>